{
  "opencollection": "1.0.0",
  "info": {
    "name": "Donorbox Campaigns API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Campaigns",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List campaigns",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://donorbox.org/api/v1/campaigns",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "query",
                "description": "Filter to a single campaign by its Donorbox campaign id (documented as the `campaign_id` filter)."
              },
              {
                "name": "name",
                "value": "",
                "type": "query",
                "description": "Filter campaigns by campaign name."
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Page number to return."
              },
              {
                "name": "per_page",
                "value": "",
                "type": "query",
                "description": "Number of records per page. Default 50, maximum 100 (values above 100 fall back to the default)."
              },
              {
                "name": "order",
                "value": "",
                "type": "query",
                "description": "Sort order."
              }
            ]
          },
          "docs": "Returns all fundraising campaigns for the authenticated organization. Endpoint confirmed in the official README; response fields confirmed from the documented sample payload."
        }
      ]
    }
  ],
  "bundled": true
}