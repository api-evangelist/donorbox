{
  "opencollection": "1.0.0",
  "info": {
    "name": "Donorbox Campaigns Purchases API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Purchases",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List event ticket purchases",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://donorbox.org/api/v1/purchases",
            "params": [
              {
                "name": "payment_status",
                "value": "",
                "type": "query",
                "description": "Filter purchases by payment status. Defaults to `succeeded` if an invalid value is passed."
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Page number to return."
              },
              {
                "name": "per_page",
                "value": "",
                "type": "query",
                "description": "Number of records per page. Default 50, maximum 100 (values above 100 fall back to the default)."
              },
              {
                "name": "order",
                "value": "",
                "type": "query",
                "description": "Sort order."
              }
            ]
          },
          "docs": "Returns all event ticket purchase transactions for the authenticated organization. Endpoint and response shape confirmed in the official README sample payload."
        }
      ]
    }
  ],
  "bundled": true
}